#!/bin/sh
# Thor 80% limit across sleep: clamp before suspend when on charger at >=70%, re-evaluate after resume.
B=/sys/class/power_supply/battery; U=/sys/class/power_supply/qcom-battmgr-usb
[ -e "$B/charge_control_limit" ] || exit 0
case "$1" in
  pre)  [ "$(cat $U/online 2>/dev/null)" = 1 ] && [ "$(cat $B/capacity 2>/dev/null || echo 0)" -ge 70 ] && echo 1000 > "$B/charge_control_limit" ;;
  post) systemctl restart thor-charge-limit.service ;;
esac
exit 0
